{
  "name": "claude-status-usage",
  "displayName": "Claude Usage Status (unofficial)",
  "description": "%description%",
  "version": "0.1.0",
  "publisher": "bryanfagundes",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/BryanFag/claude-usage-status.git"
  },
  "bugs": {
    "url": "https://github.com/BryanFag/claude-usage-status/issues"
  },
  "homepage": "https://github.com/BryanFag/claude-usage-status#readme",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1E1E1E",
    "theme": "dark"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "claude",
    "claude code",
    "usage",
    "rate limit",
    "quota",
    "status bar",
    "limits"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./extension.js",
  "l10n": "./l10n",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "claudeUsageStatusbar.refresh",
        "title": "%command.refresh.title%"
      }
    ],
    "icons": {
      "claude-usage-bar-0": {
        "description": "Usage bar at 0%",
        "default": {
          "fontPath": "./media/usage-bar.woff",
          "fontCharacter": "\\E000"
        }
      },
      "claude-usage-bar-5": {
        "description": "Usage bar at 5%",
        "default": {
          "fontPath": "./media/usage-bar.woff",
          "fontCharacter": "\\E001"
        }
      },
