{
  "name": "claude-usage-statusbar",
  "displayName": "Claude Usage Status Bar",
  "description": "Mostra o uso do plano do Claude (5 h e 7 dias) na barra de status",
  "version": "0.0.5",
  "publisher": "bryanfagundes",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/BryanFag/claude-usage-status.git"
  },
  "bugs": {
    "url": "https://github.com/BryanFag/claude-usage-status/issues"
  },
  "homepage": "https://github.com/BryanFag/claude-usage-status#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "claudeUsageStatusbar.refresh",
        "title": "Claude Usage: Atualizar"
      }
    ],
    "icons": {
      "claude-usage-bar-0": {
        "description": "Barra de uso em 0%",
        "default": {
          "fontPath": "./media/usage-bar.woff",
          "fontCharacter": "\\E000"
        }
      },
      "claude-usage-bar-5": {
        "description": "Barra de uso em 5%",
        "default": {
          "fontPath": "./media/usage-bar.woff",
          "fontCharacter": "\\E001"
        }
      },
